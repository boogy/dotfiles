// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Shift focus to editor from terminal
  {
    "context": "Terminal",
    "bindings": {
      "cmd-g e": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      // Key-bindings for being in terminal
      "ctrl-w i": "terminal_panel::ToggleFocus",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
    },
  },
  // Shift focus to terminal from editor
  {
    "context": "Editor",
    "bindings": {
      "cmd-j": "terminal_panel::ToggleFocus",
      "cmd-+": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "cmd-g e": "terminal_panel::ToggleFocus",
      "cmd-k l": "language_selector::Toggle",
      "cmd-alt-s": "editor::SortLinesCaseInsensitive",
    },
  },

  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      // visual, visual line & visual block modes
      "g c": "editor::ToggleComments",
    },
  },

  // Replicate tmux movements
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",

      "cmd-g a": "agent::FocusAgent",

      "ctrl-x h": "workspace::ActivatePaneLeft",
      "ctrl-x l": "workspace::ActivatePaneRight",
      "ctrl-x j": "workspace::ActivatePaneDown",
      "ctrl-x k": "workspace::ActivatePaneUp",

      "alt-shift-h": "workspace::ActivatePaneLeft",
      "alt-shift-l": "workspace::ActivatePaneRight",
      "alt-shift-j": "workspace::ActivatePaneDown",
      "alt-shift-k": "workspace::ActivatePaneUp",

      // Global "back to editor" button
      "ctrl-alt-enter": "workspace::ActivateNextPane",

      // Open recent
      "ctrl-r": "projects::OpenRecent",
    },
  },

  // Git
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-z": "git::Uncommit",
      "ctrl-delete": "git::RestoreTrackedFiles",
      "ctrl-s": "git::Fetch",
    },
  },

  // Pane
  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
    },
  },
  // Project panel
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-n": "project_panel::NewFile",
      "ctrl-shift-n": "project_panel::NewDirectory",
    },
  },

  // Toggle agent thread switcher (cycle through open threads)
  {
    "context": "AgentPanel || ThreadSwitcher || ThreadsSidebar || Workspace",
    "bindings": {
      "alt-shift-l": "agents_sidebar::ToggleThreadSwitcher",
    },
  },

  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // TODO: Maybe check for another keybinding and other ways to do this.
      // FIXME: Right now the active pane is also split to the right due to async nature
      // (related to https://github.com/zed-industries/zed/issues/42555).
      // "space t v": [
      //   "action::Sequence",
      //   ["workspace::NewCenterTerminal", "pane::SplitRight"],
      // ],
      "space t l": ["action::Sequence", ["workspace::NewCenterTerminal", "pane::SplitRight"]],
      "space t h": ["action::Sequence", ["workspace::NewCenterTerminal", "pane::SplitLeft"]],

      "space f": "editor::Format",

      // Finders & Formats
      "space p f": "file_finder::Toggle",
      "space p r": "pane::DeploySearch",
      "space p t": "tab_switcher::Toggle",

      // Buffer Navigation
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      // Window Creation
      "s v": "pane::SplitRight",
      "s s": "pane::SplitDown",
      // Window Navigation
      "s l": "workspace::ActivatePaneRight",
      "s h": "workspace::ActivatePaneLeft",
      "s k": "workspace::ActivatePaneUp",
      "s j": "workspace::ActivatePaneDown",
    },
  },

  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Key-bindings for normal & visual mode

      // Open markdown preview
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      // Git
      "space g h d": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "g l": "vim::SelectNext",
      "g L": "vim::SelectPrevious",
      "g a": "editor::SelectAllMatches",
      "g shift-a": "editor::FindAllReferences",
      "g f": "project_symbols::Toggle",
      "space p e": "diagnostics::Deploy", // Zed specific
      "space z": "workspace::ToggleZoom", // Zed specific
    },
  },

  {
    "bindings": {
      "cmd-shift-j": "workspace::ToggleZoom",

      // Close active tab immediately
      "cmd-w": ["pane::CloseActiveItem", { "close_pinned": false }],

      "ctrl-t": "workspace::NewCenterTerminal",

      // Show all tabs
      "alt-shift-p": "tab_switcher::ToggleAll",

      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",

      // create a new terminal agent
      // "alt+a n": "agent::NewTerminalThread",
      // "alt+a s": "agent::NewThread",
      // "alt+p": "agent::CycleNextInlineAssist",
    },
  },
]
